# Copy to .env (never commit .env). On Colab use the Secrets panel instead.
LLM_BASE_URL=https://YOUR-ENDPOINT/v1
LLM_API_KEY=your-key
LLM_MODEL=your-model-name
EMBED_MODEL=your-embedding-model-name
# Only if embeddings are served at a different address or need a different key:
EMBED_BASE_URL=
EMBED_API_KEY=
# Fallback only with mentor approval: run EMBED_MODEL on this machine instead of the API
# (needs: pip install -r requirements-rerank.txt)
EMBED_PROVIDER=endpoint
# Optional tracing (Langfuse cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional tuning
CHUNKING=sections
RATE_LIMIT_PER_MIN=10
